# Copy to .env.local and fill in real values. Do not commit .env.local.

# Gmail account that sends the mail.
SMTP_USER=you@gmail.com

# A Google App Password (16 characters), NOT your normal account password.
# Create one at https://myaccount.google.com/apppasswords
# Requires 2-Step Verification to be enabled on the account.
SMTP_PASS=xxxxxxxxxxxxxxxx

# Inbox that receives contact form enquiries.
CONTACT_TO=hr@vinfotec.com

# From header. Gmail will rewrite this to the authenticated account unless the
# address is a verified alias, so keep it matching SMTP_USER.
CONTACT_FROM=Vinfotec Website <you@gmail.com>

# --- Cloudflare Turnstile (https://dash.cloudflare.com -> Turnstile) ---

# Public site key. The VITE_ prefix deliberately exposes this to the browser -
# that is correct for a site key, which is not a secret.
VITE_TURNSTILE_SITE_KEY=0x0000000000000000000000

# Secret key, server-side only. NEVER give this a VITE_ prefix, or it will be
# compiled into the public JavaScript bundle.
TURNSTILE_SECRET_KEY=0x0000000000000000000000000000000000000000

# Comma-separated hostnames the widget may legitimately be served from.
# Defaults to vinfotec.com,www.vinfotec.com,localhost,127.0.0.1
TURNSTILE_HOSTNAMES=vinfotec.com,www.vinfotec.com,localhost,127.0.0.1
